pragma solidity ^0.8.20;

/// @notice Interface for the ERC-5564 Announcer contract.
interface IERC5564Announcer {
    /// @notice Emitted when a sender announces a stealth payment.
    /// @param schemeId The scheme identifier (1 for secp256k1).
    /// @param stealthAddress The derived stealth address that receives funds.
    /// @param caller The address that called the announce function.
    /// @param ephemeralPubKey The ephemeral public key used to generate the stealth address.
    /// @param metadata Scheme-specific metadata (first byte is the view tag).
    event Announcement(
        uint256 indexed schemeId,
        address indexed stealthAddress,
        address indexed caller,
        bytes ephemeralPubKey,
        bytes metadata
    );

    /// @notice Announces a stealth address payment.
    /// @param schemeId The scheme identifier (e.g. 1 for secp256k1).
    /// @param stealthAddress The recipient's stealth address.
    /// @param ephemeralPubKey The ephemeral public key generated by the sender.
    /// @param metadata Scheme-specific metadata (the first byte MUST be the view tag).
    function announce(
        uint256 schemeId,
        address stealthAddress,
        bytes memory ephemeralPubKey,
        bytes memory metadata
    ) external;
}
