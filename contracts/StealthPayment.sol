pragma solidity ^0.8.20;

import "./IERC5564Announcer.sol";

/// @title StealthPayment
/// @notice Helper router contract for sending ETH payments and publishing ERC-5564 announcements atomically.
contract StealthPayment {
    IERC5564Announcer public immutable announcer;
    uint256 private _status = 1;

    modifier nonReentrant() {
        require(_status == 1, "StealthPayment: reentrancy rejected");
        _status = 2;
        _;
        _status = 1;
    }

    event StealthPaymentSent(
        uint256 indexed schemeId,
        address indexed stealthAddress,
        address indexed payer,
        uint256 amount,
        bytes ephemeralPubKey,
        bytes metadata
    );

    /// @param _announcer Address of the ERC-5564 Announcer contract
    constructor(address _announcer) {
        require(_announcer != address(0), "StealthPayment: announcer is zero address");
        announcer = IERC5564Announcer(_announcer);
    }

    /// @notice Pay ETH to a stealth address and publish an ERC-5564 announcement.
    /// @param schemeId The scheme identifier (1 for secp256k1).
    /// @param stealthAddress The recipient's derived stealth address.
    /// @param ephemeralPubKey The ephemeral public key generated by the payer.
    /// @param metadata Scheme metadata (first byte is the view tag).
    function payETH(
        uint256 schemeId,
        address payable stealthAddress,
        bytes memory ephemeralPubKey,
        bytes memory metadata
    ) external payable nonReentrant {
        require(msg.value > 0, "StealthPayment: payment amount must be greater than zero");
        require(stealthAddress != address(0), "StealthPayment: stealth address cannot be zero");
        require(ephemeralPubKey.length > 0, "StealthPayment: ephemeralPubKey cannot be empty");
        require(metadata.length > 0, "StealthPayment: metadata must contain view tag");

        // Checks-Effects-Interactions:
        // 1. Effects: Emit custom payment event
        emit StealthPaymentSent(
            schemeId,
            stealthAddress,
            msg.sender,
            msg.value,
            ephemeralPubKey,
            metadata
        );

        // 2. Interactions: Announce on ERC-5564 Announcer
        announcer.announce(schemeId, stealthAddress, ephemeralPubKey, metadata);

        // 3. Interactions: Forward ETH to stealth address
        (bool success, ) = stealthAddress.call{value: msg.value}("");
        require(success, "StealthPayment: ETH transfer failed");
    }

    /// @notice Direct payments not accepted.
    receive() external payable {
        revert("StealthPayment: direct payments not accepted");
    }
}
